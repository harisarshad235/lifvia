{
  "name": "paisaflow-pkr",
  "version": "1.0.0",
  "description": "All-in-One PKR Money Management App (Web + Capacitor Android APK) with Cloudflare D1 & Local-First Persistence",
  "type": "module",
  "scripts": {
    "start": "node server.mjs",
    "dev": "node --watch server.mjs",
    "cap:sync": "npx cap sync android",
    "cap:open": "npx cap open android",
    "deploy": "npx wrangler pages deploy public --project-name=paisaflow-pkr --branch=main --commit-dirty=true"
  },
  "dependencies": {
    "@capacitor/android": "^8.0.0",
    "@capacitor/cli": "^8.0.0",
    "@capacitor/core": "^8.0.0"
  }
}
