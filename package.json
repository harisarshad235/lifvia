{
  "name": "lifvia",
  "version": "2.0.0",
  "description": "Lifvia - Track your cash flow. Simulate your tomorrow. (Web + Capacitor Android APK)",
  "type": "module",
  "scripts": {
    "start": "node server.mjs",
    "dev": "node --watch server.mjs",
